# .dockerignore file for a React app

# Ignore node_modules
node_modules
npm-debug.log
yarn-error.log

# Ignore build output
build
dist

# Ignore local environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore editor directories and files
.vscode
.idea
*.sublime-project
*.sublime-workspace

# Ignore OS generated files
.DS_Store
Thumbs.db